# Copia estos valores públicos desde Supabase y agrégalos tú mismo en .env.local y en Vercel.
# No uses ni compartas una secret key o service_role key para esta aplicación.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo para el servidor de Vercel. No agregues estos valores al código ni los expongas al navegador.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Opcional: URL directa a un PDF de MIDAGRI durante una prueba manual.
MIDAGRI_BOLETIN_URL=
